# Data — track CSVs, ignore other contents (binaries handled below)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/raw/*.csv
!data/interim/*.csv
!data/processed/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.claude/

# Big outputs
*.parquet
*.pkl
*.joblib
reports/figures/*.png.bak
